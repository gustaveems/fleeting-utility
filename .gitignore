# Godot 4 editor/import cache — regenerated by `godot --headless --import`
.godot/
*.import
/android/

# Agent scratch output (screenshots, captures)
.qwen/tmp/
tools/out/

# Python
__pycache__/
*.pyc

# OS
.DS_Store
.venv/
# Third-party packs: rebuilt by tools/assets/ (free) or carried as a zip (Fab).
assets/third_party/*
# Except the easel: CC0, 27 KB, and not downloadable by script (Poly Pizza).
!assets/third_party/polypizza/
assets/_downloads/

# Playtest screenshots and inspiration photos: local only, never committed. The two
# plans in docs/references are tracked (CLAUDE.md points at them), so they're kept.
Feedback/
docs/references/*.jpg
docs/references/*.jpeg
docs/references/*.png
docs/references/*.avif
docs/references/*.webp
!docs/references/city_plan_v1.png
!docs/references/sketch_walk_layout.png
